From 019e1cc6c91ba48c468406d0f63bea92450cae22 Mon Sep 17 00:00:00 2001
From: Riad Mashrub Shourov <shourovrm@gmail.com>
Date: Fri, 6 Nov 2026 11:13:57 +0600
Subject: [PATCH 4/5] patch: SABR context handshake is not a backoff

---
 .../youtube/sabr/YoutubeSabrSession.java         | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/sabr/YoutubeSabrSession.java b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/sabr/YoutubeSabrSession.java
index 9422401e..52be0ec3 100644
--- a/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/sabr/YoutubeSabrSession.java
+++ b/extractor/src/main/java/org/schabi/newpipe/extractor/services/youtube/sabr/YoutubeSabrSession.java
@@ -136,7 +136,14 @@ public final class YoutubeSabrSession {
             throw new SabrProtocolException("SABR backoff exceeds limit: "
                     + result.getBackoffTimeMs() + "ms");
         }
-        updateBackoff(result.getBackoffTimeMs());
+        if (isContextHandshake(result)) {
+            // The server answered with a context to echo and no media: the next request is a
+            // different request, not a retry, so its backoff hint is not a wait.
+            addDiagnosticEvent("context_handshake n=" + requestNumber
+                    + " skippedBackoffMs=" + result.getBackoffTimeMs());
+        } else {
+            updateBackoff(result.getBackoffTimeMs());
+        }
         diagnostics.recordResponse(result, requestNumber);
         updateBandwidthEstimate(result.getResponseBytes(), result.getRequestElapsedMs());
         requestNumber++;
@@ -419,6 +426,13 @@ public final class YoutubeSabrSession {
         }
     }
 
+    /** A response that carries a new SABR context, no media and a backoff: the first exchange of a session. */
+    private static boolean isContextHandshake(@Nonnull final YoutubeSabrResponse response) {
+        return response.getBackoffTimeMs() > 0
+                && response.getSegmentCount() == 0
+                && !response.getSabrContextUpdates().isEmpty();
+    }
+
     private void ingestControl(@Nonnull final YoutubeSabrResponse response) {
         final byte[] nextRequestPolicy = response.getNextRequestPolicy();
         if (nextRequestPolicy != null) {
